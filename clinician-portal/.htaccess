# ============================================================
# React SPA — Apache config for cPanel/GoDaddy shared hosting
# ============================================================

# --- MIME types (critical for static assets served without a build server) ---
<IfModule mod_mime.c>
  AddType application/pdf .pdf
  AddType application/javascript .js .mjs
  AddType text/css .css
  AddType image/svg+xml .svg
  AddType font/woff2 .woff2
  AddType font/woff .woff
  AddType application/json .json
</IfModule>

# --- Force correct Content-Type + inline display for PDFs ---
<IfModule mod_headers.c>
  <FilesMatch "\.pdf$">
    Header set Content-Type "application/pdf"
    Header set Content-Disposition "inline"
  </FilesMatch>
</IfModule>

# --- Rewrite engine: SPA fallback, but never swallow real files ---
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Force HTTPS (remove this block if SSL isn't configured yet)
  RewriteCond %{HTTPS} off
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # If the request matches an actual file or directory on disk
  # (e.g. /resources/asthma-action-plan.pdf, /assets/index-abc123.js),
  # serve it directly — do NOT fall through to index.html.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Everything else (actual app routes like /dashboard, /patients/12)
  # gets routed to index.html so React Router can handle it client-side.
  RewriteRule ^ index.html [L]
</IfModule>

# --- Caching: long cache for hashed build assets, no-cache for index.html ---
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2?|png|jpg|jpeg|gif|svg|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  # PDFs and other resource files: cache briefly, revalidate
  <FilesMatch "\.pdf$">
    Header set Cache-Control "public, max-age=3600, must-revalidate"
  </FilesMatch>
</IfModule>

# --- Compression ---
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

# --- Basic security headers ---
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# --- Disable directory listing ---
Options -Indexes